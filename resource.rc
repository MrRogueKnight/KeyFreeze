// ============================================================================
// KeyFreeze Resource File
// ============================================================================
#include <windows.h>
#include "resource.h"

IDI_KEYFREEZE ICON "keyfreeze.ico"

IDD_KEYBOARD_DLG DIALOGEX 0, 0, 380, 310
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "KeyFreeze - Select Keyboards"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Select which keyboards to lock:", IDC_STATIC, 10, 10, 360, 12
    LISTBOX         IDC_KEYBOARD_LIST, 10, 25, 360, 160,
                    LBS_MULTIPLESEL | LBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Statistics:", IDC_STATIC, 10, 195, 360, 10
    LTEXT           "", IDC_STATS_TEXT, 15, 208, 350, 55, SS_LEFT
    PUSHBUTTON      "Select All", IDC_SELECT_ALL, 10, 275, 70, 22
    PUSHBUTTON      "Deselect All", IDC_DESELECT_ALL, 90, 275, 70, 22
    DEFPUSHBUTTON   "OK", IDOK, 215, 275, 70, 22
    PUSHBUTTON      "Cancel", IDCANCEL, 295, 275, 70, 22
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "KeyFreeze Project"
            VALUE "FileDescription", "Per-Keyboard Input Locking Utility"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "KeyFreeze"
            VALUE "LegalCopyright", "Copyright (C) 2024"
            VALUE "OriginalFilename", "KeyFreeze.exe"
            VALUE "ProductName", "KeyFreeze"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END